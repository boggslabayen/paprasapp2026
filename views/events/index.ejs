<!doctype html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/header.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>


</head>

<body>

  <%- include('../partials/header-nav') %>

  <main class="my-8">
    <div class="max-w-3xl mx-auto text-center mb-8">
      <h3 class="font-black text-2xl md:text-3xl mb-6">
        UPCOMING EVENTS
      </h3>
      <p class=text-black text-base md:text-lg leading-relaxed mb-16>
        Stay updated on the latest events, workshops, conferences, and seminars designed to inspire and elevate your practice.
      </p>
    </div>

    <div class="mx-auto max-w-3xl text-center my-8">
      <div class="grid grid-cols-3 gap-4">
        <% events.forEach(event => { %>
        <article class="border-2 border-gray-200 rounded-lg">
          <a href="/events/<%= event._id %>" class="block rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="gap-8 items-center">
              <div class="">
                <img src="<%= event.bannerUrl %>" alt="<%= event.title %> banner" class="w-full h-48 object-cover" />
              </div>

              <div class=" text-left gap-4 px-4">
                <div>
                  <h4 class=" font-bold text-2xl mb-2"><%= event.title %></h4>

                  <%= event.contentHtml.replace(/<[^>]+>/g, '').substring(0, 100) + '...' %>
                </div>
                <div>
                  <button class="my-4 secondary-ctabtn">
                    Read More
                  </button>
                </div>
              </div>
            </div>

          </a>
        </article>
        <% }) %>
      </div>




    </div>

    <%- include('../partials/footer') %>
  </main>



</body>

</html>