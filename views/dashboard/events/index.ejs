<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <!-- <script src="/js/deleteModal.js" defer></script> -->

</head>



<body>

  <%- include("../partials/dashboardheader.ejs") %>

  <div class=" w-5xl max-w-5xl place-self-center">


    <div class="flex justify-between py-8 items-center">
      <p class="text-lg font-bold">Dashboard / Events</p>
      <a href="/dashboard/events/add"><button class="primary-ctabtn">Add Events</button></a>
    </div>

    <div>
      <table class="w-full border border-gray-300 divide-y divide-gray-200">
        <thead class="bg-gray-100">
          <th>Image</th>
          <th>Title</th>
          <th>Action</th>
        </thead>



        <tbody>
          <% events.forEach(event => { %>
          <tr class="odd:bg-white even:bg-gray-50">

            <td class="text-center py-2">
              <img src="<%= event.bannerUrl %>" alt="Banner for <%= event.title %>" class="w-16 h-16" />
            </td>

            <td class="text-center py-2">
              <%= event.title %>
            </td>

            <td class="text-center py-2">

              <a href="/dashboard/events/<%= event._id %>/edit" class="mr-4 text-blue-600">
                Edit
              </a>

              <a href="/dashboard/events/<%= event._id %>/delete" class="mr-4 text-red-600 delete-btn">
                Delete
              </a>



            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>

</body>

</html>