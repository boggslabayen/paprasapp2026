<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= events.title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>

  <div id="deleteModal" class=" flex fixed inset-0 bg-black bg-opacity-50 place-items-center justify-center z-50">

    <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-6">

      <h2 class="text-lg font-semibold mb-4">
        Confirm Deletion
      </h2>

      <p class="mb-6 text-gray-600">
        Are you sure you want to delete
        <span id="eventName" class="font-medium"></span>?
        This action cannot be undone.
      </p>

      <div class="flex justify-end space-x-3">

        <a href="/dashboard/events">
          <button id="cancelDelete" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
            Cancel
          </button>
        </a>

        <form id="deleteForm" method="POST" action="/dashboard/events/<%= events._id %>/delete">
          <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">
            Delete
          </button>
        </form>

      </div>
    </div>
  </div>

</body>

</html>