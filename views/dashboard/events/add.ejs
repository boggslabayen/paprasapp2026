<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Create New Event</title>

  <!-- Quill CSS -->
  <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />

  <!-- Page CSS -->
  <link rel="stylesheet" href="/css/addService.css" />
</head>

<body>
  <h1>Create a New Event</h1>

  <form id="postForm" method="POST" action="/dashboard/events/add">
    <label for="title">Event Title</label>
    <input id="title" name="title" type="text" placeholder="Post title" required />

    <label for="eventUrl">Event URL</label>
    <input id="eventUrl" name="eventUrl" type="text" placeholder="Event URL" />


    <label for="bannerFile">Image banner</label>

    <div class="banner-row">
      <div class="banner-left">
        <input id="bannerFile" type="file" accept="image/*" />
        <p class="hint">
          Uploads to <code>/upload-banner</code> and saves the returned URL.
        </p>
        <div id="bannerStatus" class="status"></div>
      </div>

      <div class="banner-right">
        <img id="bannerPreview" class="preview" alt="Banner preview" />
      </div>
    </div>

    <input type="hidden" id="bannerUrl" name="bannerUrl" />

    <label>Content</label>
    <div id="editor"></div>

    <input type="hidden" id="contentHtml" name="contentHtml" />

    <button id="publishBtn" type="submit">Publish</button>
  </form>

  <!-- Quill JS -->
  <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>

  <!-- Page JS -->
  <script src="/js/addService.js"></script>
</body>

</html>