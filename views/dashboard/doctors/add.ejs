<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>


</head>

<body class=" w-5xl max-w-5xl place-self-center">
  <section class="max-w-full mt-16">
    <h1 class="text-xl font-black my-8">Add Doctor</h1>

    <form action="/dashboard/doctors/add" method="post" class="bg-gray-100 p-8 border-2 border-gray-200 rounded-xl">


      <div>
        <label for="firstName">First Name:</label>
        <input type="text" id="firstName" name="firstName" class=" p-2 border-1 border-gray-200 rounded-md min-w-full bg-white" />
      </div>

      <div>
        <label for="lastName">Last Name:</label>
        <input type="text" id="lastName" name="lastName" class=" p-2 border-1 border-gray-200 rounded-md min-w-full bg-white" />
      </div>

      <div>
        <label for="City">City:</label>
        <input type="text" id="city" name="city" class=" p-2 border-1 border-gray-200 rounded-md min-w-full bg-white" />
      </div>
      <div class="justify-self-end">
        <a href="/dashboard/doctors" class="rounded-full p-2 border-1 mx-8 hover:bg-amber-500">
          ← Back
        </a>
        <button type="submit" class="primary-ctabtn mt-4">Add</button>

      </div>




    </form>
  </section>
</body>

</html>