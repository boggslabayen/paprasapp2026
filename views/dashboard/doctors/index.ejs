<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

  <%- include("../partials/dashboardheader.ejs") %>


  <div class=" w-5xl max-w-5xl place-self-center">



    <div class="flex justify-between py-8 items-center">
      <p class="text-lg font-bold">Dashboard / Doctors</p>

      <a href="/dashboard/doctors/add"><button class="primary-ctabtn">Add Doctor</button></a>
    </div>

    <div>
      <table class="w-full border border-gray-300 divide-y divide-gray-200">
        <thead class="bg-gray-100">
          <th>First Name</th>
          <th>Last Name</th>
          <th>Region</th>
          <th>Province</th>
          <th>City</th>
          <th>Action</th>
        </thead>



        <tbody>
          <% doctors.forEach(doctor => { %>
          <tr class="odd:bg-white even:bg-gray-50">
            <td class="text-center align-middle py-2"><%= doctor.firstName %></td>
            <td class="text-center align-middle py-2"><%= doctor.lastName %></td>
            <td class="text-center align-middle py-2"><%= doctor.region %></td>
            <td class="text-center align-middle py-2"><%= doctor.province %></td>
            <td class="text-center align-middle py-2"><%= doctor.city %></td>

            <td class="text-center py-2">

              <a href="/dashboard/doctors/<%= doctor._id %>/edit" class="mr-4 text-blue-600">
                Edit
              </a>

              <a href="/dashboard/doctors/<%= doctor._id %>/delete" class="mr-4 text-red-600 delete-btn">
                Delete
              </a>

            </td>

          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>


</body>

</html>