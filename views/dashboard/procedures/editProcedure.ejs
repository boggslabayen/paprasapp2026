<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Add Procedure</title>

  <!-- Quill CSS -->
  <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />

  <!-- Quill JS -->
  <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js" defer></script>
  <script src="/js/addService.js" defer></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Page CSS -->
  <link rel="stylesheet" href="/css/addService.css" />
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class=" w-5xl max-w-5xl place-self-center">

  <section class="max-w-full my-16">
    <h1 class="text-xl font-black my-8">Edit Procedure</h1>

    <!-- ✅ edit route -->
    <form id="postForm" method="POST" action="/dashboard/procedures/<%= procedure._id %>/edit">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" value="<%= procedure.title || '' %>" class="p-2 border-1 border-gray-200 rounded-md min-w-full bg-white" required />

      <label for="category">Category</label>
      <select id="category" name="category" class="p-2 border-1 border-gray-200 rounded-md min-w-full bg-white" required>
        <option value="" disabled>Select a category</option>

        <option value="Aesthetic" <%= procedure.category === 'Aesthetic' ? 'selected' : '' %>>
          Aesthetic
        </option>
        <option value="Reconstructive" <%= procedure.category === 'Reconstructive' ? 'selected' : '' %>>
          Reconstructive
        </option>
        <option value="Non Surgical" <%= procedure.category === 'Non Surgical' ? 'selected' : '' %>>
          Non Surgical
        </option>
      </select>

      <label for="bannerFile">Image banner</label>

      <div class="banner-row">
        <div class="banner-left">
          <input id="bannerFile" type="file" accept="image/*" class="p-2 border-1 border-gray-200 rounded-md min-w-full bg-white" />
          <p class="hint">
            Uploads to <code>/upload-banner</code> and saves the returned URL.
          </p>
          <div id="bannerStatus" class="status"></div>
        </div>

        <div class="banner-right">
          <!-- JS will use bannerUrl to show preview on load -->
          <img id="bannerPreview" class="preview" alt="Banner preview" style="display:none;" />

          <button type="button" id="removeBannerBtn" class="secondary-ctabtn w-full text-center" style="display:none;">
            Remove banner
          </button>
        </div>
      </div>

      <!-- ✅ preload existing banner url -->
      <input type="hidden" id="bannerUrl" name="bannerUrl" value="<%= procedure.bannerUrl || '' %>" />

      <label>Content</label>
      <div id="editor"></div>

      <input type="hidden" id="contentHtml" name="contentHtml" />

      <!-- ✅ safe way to preload Quill HTML (avoid putting HTML in an input value) -->
      <div id="contentHtmlInitial" style="display:none;">
        <%- procedure.contentHtml || '' %>
      </div>

      <div class="justify-self-end">
        <a href="/dashboard/procedures" class="rounded-full p-2 border-1 mx-8 hover:bg-amber-500">
          ← Back
        </a>
        <button id="publishBtn" type="submit" class="primary-ctabtn">Update</button>
      </div>
    </form>
  </section>

</body>

</html>