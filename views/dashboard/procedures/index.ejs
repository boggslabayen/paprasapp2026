<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>
  <%- include("../partials/dashboardheader.ejs") %>

  <div class=" w-5xl max-w-5xl place-self-center">


    <div class="flex justify-between py-8 items-center">
      <p class="text-lg font-bold">Dashboard / Procedures</p>
      <a href="/dashboard/procedures/add"><button class="primary-ctabtn">Add Procedure</button></a>
    </div>

    <div>
      <table class="w-full border border-gray-300 divide-y divide-gray-200">
        <thead class="bg-gray-100">
          <th>Image</th>
          <th>Title</th>
          <th>Category</th>
          <th>Action</th>
        </thead>



        <tbody>
          <% procedures.forEach(procedure => { %>
          <tr class="odd:bg-white even:bg-gray-50">
            <td class="text-center align-middle py-2 place-items-center"><img src="<%= procedure.bannerUrl %>" alt="Banner for <%= procedure.title %>" class="w-16 h-16 " /></td>
            <td class="text-center align-middle py-2"><%= procedure.title %></td>
            <td class="text-center align-middle py-2"><%= procedure.category %></td>
            <!-- <td class="text-center align-middle py-2"><a href="/dashboard/procedures/<%= procedure._id %>/edit">Edit</a></td> -->

            <td class="text-center py-2">

              <a href="/dashboard/procedures/<%= procedure._id %>/edit" class="mr-4 text-blue-600">
                Edit
              </a>

              <a href="/dashboard/procedures/<%= procedure._id %>/delete" class="mr-4 text-red-600 delete-btn">
                Delete
              </a>

            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>

    </div>

  </div>

</body>

</html>