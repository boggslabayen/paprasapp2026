<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

  <%- include("../partials/dashboardheader.ejs") %>
  <div class=" w-5xl max-w-5xl place-self-center">



    <div class="flex justify-between py-8 items-center">
      <p class="text-lg font-bold">Dashboard / Settings</p>


      <% if (currentUser && currentUser.type === "admin") { %>
      <a href="/dashboard/settings/add"><button class="primary-ctabtn">Add User</button></a>
      <% } else{ %>
      <a href="/dashboard/settings/<%= currentUser._id %>/update">
        <button class="primary-ctabtn">Update Password</button>
      </a>
      <% } %>

    </div>

    <div>
      <table class="w-full border border-gray-300 divide-y divide-gray-200">
        <thead class="bg-gray-100">
          <th>First Name</th>
          <th>Last Name</th>
          <th>Email</th>
          <th>User Type</th>
          <% if (currentUser.type === "admin") { %>
          <th>Action</th>
          <% }  %>
        </thead>



        <tbody>
          <% users.forEach(user => { %>
          <tr class="odd:bg-white even:bg-gray-50">
            <td class="text-center align-middle py-2"><%= user.firstName %></td>
            <td class="text-center align-middle py-2"><%= user.lastName %></td>
            <td class="text-center align-middle py-2"><%= user.email %></td>
            <td class="text-center align-middle py-2"><%= user.type %></td>
            <% if (currentUser.type === "admin") { %>
            <td class="text-center align-middle py-2"><a href="/dashboard/settings/<%= user._id %>/update">Update Password</a></td>

            <% }  %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</body>

</html>