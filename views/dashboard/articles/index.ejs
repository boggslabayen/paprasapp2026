<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class=" w-5xl max-w-5xl place-self-center">

  <div class="max-w-full mt-16">
    <h1 class="text-xl font-black my-8">Articles</h1>
    <header class=" bg-gray-100 p-2 rounded-full ">
      <nav class="">
        <ul class="flex justify-around">
          <li class="hover:text-amber-500"><a href="/profile">Profile</a></li>
          <li class="hover:text-amber-500"><a href="/dashboard/doctors">Doctors</a></li>
          <li class="hover:text-amber-500"><a href="/dashboard/procedures">Procedures</a></li>
          <li class="hover:text-amber-500"><a href="/dashboard/articles">Articles</a></li>
          <li class="hover:text-amber-500"><a href="/dashboard/events">Events</a></li>
          <li class="hover:text-amber-500"><a href="/settings">Settings</a></li>
          <li class="hover:text-amber-500"><a href="/logout">Logout</a></li>
        </ul>
      </nav>
    </header>
  </div>

  <div class="flex justify-between py-8 items-center">
    <p class="text-lg font-bold">Dashboard / Articles</p>
    <a href="/dashboard/articles/add"><button class="primary-ctabtn">Add Articles</button></a>
  </div>

  <div>
    <table class="w-full border border-gray-300 divide-y divide-gray-200">
      <thead class="bg-gray-100">
        <th>Image</th>
        <th>Title</th>
        <th>Action</th>
      </thead>



      <tbody>
        <% articles.forEach(article => { %>
        <tr class="odd:bg-white even:bg-gray-50">
          <td class="text-center align-middle py-2 place-items-center"><img src="<%= article.bannerUrl %>" alt="Banner for <%= article.title %>" class="w-16 h-16 " /></td>
          <td class="text-center align-middle py-2"><%= article.title %></td>
          <td class="text-center align-middle py-2"><a href="/dashboard/articles/<%= article._id %>/edit">Edit</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>


</body>

</html>