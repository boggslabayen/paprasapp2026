<body>

  <%- include('../partials/header-nav') %>

  <section class="my-8 ">
    <div class="md:flex items-center content-center gap-2 max-w-4xl mx-auto py-8">
      <div class="md:w-2/3">
        <img src="https://paparas-web-2026.sgp1.cdn.digitaloceanspaces.com/becomeamember/1.png" width="656" height="498" class="h-full pb-8 md:pb-0" />
      </div>
      <div class="md:w-3/5 px-8 md:px-0">
        <h3 class="font-black text-2xl md:text-3xl mb-4">
          Our Doctors
        </h3>
        <p class="text-black text-base md:text-lg leading-relaxed mb-8">
          Find highly skilled and accredited PAPRAS doctors in major cities across the Philippines. Trust in the expertise of professionals dedicated to the highest standards in plastic, reconstructive, and aesthetic surgery.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto py-8">

    <h2 class="font-bold text-2xl">Our Fellows</h2>

    <!-- Doctor Type Tabs -->
    <div class="flex gap-6 my-4">
      <a href="/doctors?doctor_type=licensed-surgeon<%= selectedRegion ? `&region=${encodeURIComponent(selectedRegion)}` : '' %>" class="<%= selectedType === 'licensed-surgeon' ? 'font-bold underline' : '' %>">
        Licensed Surgeons
      </a>

      <a href="/doctors?doctor_type=board-eligible<%= selectedRegion ? `&region=${encodeURIComponent(selectedRegion)}` : '' %>" class="<%= selectedType === 'board-eligible' ? 'font-bold underline' : '' %>">
        Board Eligible
      </a>
    </div>

    <!-- Region Filter -->
    <form class="bar" method="GET" action="/doctors">

      <!-- Preserve doctor_type when region changes -->
      <input type="hidden" name="doctor_type" value="<%= selectedType %>">

      <label for="region">Filter by region:</label>

      <select id="region" name="region" onchange="this.form.submit()" class=" p-4 border-1 border-gray-200 rounded-md min-w-64 bg-white">
        <option value="">All regions</option>

        <% regions.forEach(r => { %>
        <option value="<%= r %>" <%= selectedRegion === r ? "selected" : "" %>>
          <%= r %>
        </option>
        <% }) %>
      </select>

      <% if (selectedRegion) { %>
      <a href="/doctors?doctor_type=<%= selectedType %>">Clear</a>
      <% } %>
    </form>

    <% if (!doctors || doctors.length === 0) { %>
    <div class="empty">
      No doctors found
      <% if (selectedRegion) { %> for <%= selectedRegion %><% } %>.
    </div>
    <% } else { %>
    <div class="grid">
      <% doctors.forEach(d => { %>
      <div class="card">
        <div class="name">
          Dr.
          <%= (d.firstName + " " + d.lastName)
                  .toLowerCase()
                  .replace(/\b\w/g, c => c.toUpperCase())
            %>
        </div>



        <div class="muted">
          Location:<br />
          <%= d.city || "—" %><% if (d.province) { %>, <%= d.province %><% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>

  <%- include('../partials/become-member') %>
  <%- include('../partials/footer') %>

</body>

</html>