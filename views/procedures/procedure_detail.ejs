<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= procedure.title %></title>

  <!-- Css here -->
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/header.css" />

  <script type="module" src="/js/index.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

  <%- include('../partials/header-nav') %>

  <section class="mt-8 px-4">
    <div class="flex flex-col md:flex-row content-center gap-10 max-w-4xl mx-auto py-8">


      <div class="w-full md:w-1/2 static">
        <img src="<%= procedure.bannerUrl %>" alt="<%= procedure.title %> Image" class="pb-8 md:pb-0" width="400" height="400">
      </div>

      <div class=" md:w-1/2 article-content">
        <h1 class=" font-black text-2xl md:text-3xl mb-4"><%= procedure.title %></h1>
        <%- procedure.contentHtml %>
      </div>


    </div>
  </section>

  <%- include('../partials/footer') %>
</body>

</html>